{
  "name": "oneatlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
